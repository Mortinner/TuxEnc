# Copia este archivo como «keys.env» (que git ignora) y pon las claves del proyecto TuxEnc.
# packaging/build.py las mete, algo ofuscadas, dentro del AppImage. También valen las variables
# de entorno TUXENC_KEY_TMDB, TUXENC_KEY_TVDB y TUXENC_KEY_OMDB (p. ej. secretos del CI).
TMDB=
TVDB=
# OMDb: déjala vacía salvo que sea una clave de mecenas (la gratuita, compartida, se agota en un día)
OMDB=
